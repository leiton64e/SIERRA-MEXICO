local SAFE_NAMES = { safezone=1, zonasegura=1, spawnzone=1, lobby=1, carga=1 }
local function norm(s) return string.lower((s or ""):gsub("^%s*(.-)%s*$", "%1")) end

local safeZones = {}
local function addZone(v) if v:IsA("BasePart") and SAFE_NAMES[norm(v.Name)] then safeZones[v] = true end end
for _, v in ipairs(workspace:GetDescendants()) do addZone(v) end
workspace.DescendantAdded:Connect(addZone)
workspace.DescendantRemoving:Connect(function(v) safeZones[v] = nil end)

local function inSafe(pos)
	for z in pairs(safeZones) do
		if z.Parent then
			local r, h = z.CFrame:PointToObjectSpace(pos), z.Size * 0.5
			if math.abs(r.X) <= h.X and math.abs(r.Y) <= h.Y and math.abs(r.Z) <= h.Z then return true end
		else safeZones[z] = nil end
	end
	return false
end

local allyMap = {}
local function rebuildAllies()
	table.clear(allyMap)
	local t1 = LP.Team; local n1 = t1 and norm(t1.Name)
	for _, p in ipairs(Players:GetPlayers()) do
		if p == LP then allyMap[p] = true; continue end
		local t2 = p.Team; local ok = false
		if t1 and t2 then
			local n2 = norm(t2.Name)
			ok = (t1 == t2) or (n1 == n2) or (t1.TeamColor == t2.TeamColor)
				or (CFG.Allies[n1] and CFG.Allies[n1][n2] ~= nil) or (CFG.Allies[n2] and CFG.Allies[n2][n1] ~= nil)
		elseif LP.TeamColor == p.TeamColor then ok = true end
		allyMap[p] = ok
	end
end
local function watchTeam(p) p:GetPropertyChangedSignal("Team"):Connect(rebuildAllies); p:GetPropertyChangedSignal("TeamColor"):Connect(rebuildAllies) end
for _, p in ipairs(Players:GetPlayers()) do watchTeam(p) end
Players.PlayerAdded:Connect(function(p) watchTeam(p); rebuildAllies() end)
Players.PlayerRemoving:Connect(function(p) allyMap[p] = nil end)
rebuildAllies()

local function getEnemy(p)
	if allyMap[p] then return nil end
	local c = p.Character; if not c or not c.Parent then return nil end
	local hum, root, head = c:FindFirstChildOfClass("Humanoid"), c:FindFirstChild("HumanoidRootPart"), c:FindFirstChild("Head")
	if not hum or not root or not head or hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then return nil end
	if CFG.NoSpawn and (c:FindFirstChildOfClass("ForceField") or inSafe(root.Position)) then return nil end
	return c, hum, root, head
end

local rayP = RaycastParams.new(); rayP.FilterType = Enum.RaycastFilterType.Exclude; rayP.IgnoreWater = true
local baseEx = {}
local function refreshBaseEx()
	table.clear(baseEx); table.insert(baseEx, Cam)
	if LP.Character then table.insert(baseEx, LP.Character) end
	for p, isA in pairs(allyMap) do if isA and p.Character then table.insert(baseEx, p.Character) end end
end

local function clearLOS(head, char)
	if not CFG.CheckWall then return true end
	local orig = Cam.CFrame.Position; local diff = head.Position - orig; local dist = diff.Magnitude
	if dist < 0.1 then return true end
	refreshBaseEx(); rayP.FilterDescendantsInstances = baseEx
	local dir, cur, rem = diff.Unit, orig, dist
	for _ = 1, 3 do
		local res = workspace:Raycast(cur, dir * rem, rayP)
		if not res or res.Instance:IsDescendantOf(char) then return true end
		if (not res.Instance.CanCollide) and res.Instance.Transparency >= 0.85 then
			table.insert(baseEx, res.Instance); rayP.FilterDescendantsInstances = baseEx
			local step = (res.Position - cur).Magnitude + 0.05; rem -= step
			if rem < 0.1 then return true end
			cur = res.Position + dir * 0.05
		else return false end
	end
	return false
end

