local espCache, list = {}, {}
local function dropESP(p) local e = espCache[p]; if e then if e.dc then e.dc:Disconnect() end; e.bb:Destroy(); if e.hl then e.hl:Destroy() end; espCache[p] = nil end end
Players.PlayerRemoving:Connect(dropESP)

local function stepESP()
	if not CFG.ESP then for p in pairs(espCache) do dropESP(p) end; return end
	local myR = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	local orig = myR and myR.Position or Cam.CFrame.Position
	table.clear(list)
	for _, p in ipairs(Players:GetPlayers()) do
		local c, hum, root = getEnemy(p)
		if not c then dropESP(p); continue end
		local d = (root.Position - orig).Magnitude
		if d > CFG.MaxDist then dropESP(p); continue end
		table.insert(list, { p=p, c=c, hum=hum, root=root, d=d })
	end
	table.sort(list, function(a,b) return a.d < b.d end)
	for idx, it in ipairs(list) do
		local e = espCache[it.p]
		if not e then
			local bb = Instance.new("BillboardGui"); bb.Adornee = it.root; bb.Size = UDim2.fromOffset(180,36); bb.StudsOffset = Vector3.new(0,2.7,0); bb.AlwaysOnTop = true; bb.Parent = GuiParent
			local lbl = Instance.new("TextLabel"); lbl.Size = UDim2.fromScale(1,1); lbl.BackgroundTransparency = 1; lbl.Font = Enum.Font.GothamBold; lbl.TextSize = 12; lbl.TextColor3 = Color3.fromRGB(255,65,65); lbl.TextStrokeTransparency = 0.2; lbl.Parent = bb
			e = { bb=bb, lbl=lbl, dc = it.hum.Died:Connect(function() dropESP(it.p) end) }; espCache[it.p] = e
		elseif e.bb.Adornee ~= it.root then e.bb.Adornee = it.root end
		if CFG.XRay and idx <= CFG.MaxHL then
			if not e.hl then local hl = Instance.new("Highlight"); hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; hl.FillColor = Color3.fromRGB(255,65,65); hl.OutlineColor = Color3.fromRGB(255,65,65); hl.FillTransparency = 0.65; hl.OutlineTransparency = 0.1; hl.Parent = GuiParent; e.hl = hl end
			if e.hl.Adornee ~= it.c then e.hl.Adornee = it.c end
		elseif e.hl then e.hl:Destroy(); e.hl = nil end
		local txt = string.format("%s | %dHP | %dm", it.p.Name, math.floor(it.hum.Health), math.floor(it.d))
		if e.lbl.Text ~= txt then e.lbl.Text = txt end
	end
end

local lockedPlr: Player? = nil
local function validSticky(p, cx, cy, holdSq, camPos)
	if not p or not p.Parent then return nil end
	local c, _, _, head = getEnemy(p); if not c then return nil end
	local d = (head.Position - camPos).Magnitude; if d > CFG.MaxDist then return nil end
	local sp, vis = Cam:WorldToViewportPoint(head.Position); if not vis or sp.Z <= 0 then return nil end
	local dx, dy = sp.X - cx, sp.Y - cy
	if (dx*dx + dy*dy) > holdSq then return nil end
	if not clearLOS(head, c) then return nil end
	return head
end

local acc, lastInfo, lastLock = 0, "", nil
RunService:BindToRenderStep("SierraLoop", Enum.RenderPriority.Camera.Value + 1, function(dt)
	Cam = workspace.CurrentCamera or Cam; if not Cam then return end
	acc += dt; if acc >= CFG.ESPInt then acc = 0; stepESP() end

	local locked, blocked = nil, false
	if CFG.Aim then
		local vp = Cam.ViewportSize; local cx, cy = vp.X*0.5, vp.Y*0.5; local fovSq = CFG.FOV * CFG.FOV
		local holdR = CFG.FOV * 1.45; local holdSq = holdR * holdR
		local camPos = Cam.CFrame.Position; local bestH, bestP = nil, nil

		if CFG.Sticky and lockedPlr then
			local sh = validSticky(lockedPlr, cx, cy, holdSq, camPos)
			if sh then bestH, bestP = sh, lockedPlr else lockedPlr = nil end
		end

		if not bestH then
			local bestS = math.huge
			for _, p in ipairs(Players:GetPlayers()) do
				local c, _, _, head = getEnemy(p); if not c then continue end
				local d = (head.Position - camPos).Magnitude; if d > CFG.MaxDist then continue end
				local sp, vis = Cam:WorldToViewportPoint(head.Position); if not vis or sp.Z <= 0 then continue end
				local dx, dy = sp.X - cx, sp.Y - cy; local dSq = dx*dx + dy*dy; if dSq > fovSq then continue end
				if not clearLOS(head, c) then blocked = true; continue end
				local sc = math.sqrt(dSq) + d*0.05; if sc < bestS then bestS, bestH, bestP = sc, head, p end
			end
			if CFG.Sticky and bestP then lockedPlr = bestP end
		end

		if bestH and bestP then
			locked = bestP.Name
			local cur = Cam.CFrame; local goal = CFrame.lookAt(cur.Position, bestH.Position)
			Cam.CFrame = cur.LookVector:Angle(goal.LookVector) < 0.0026 and goal or cur:Lerp(goal, math.clamp(CFG.Smooth, 0.05, 1))
		end
	else
		lockedPlr = nil
	end

	if locked ~= lastLock then
		lastLock = locked
		fovStroke.Color = locked and Color3.fromRGB(255,65,65) or Color3.new(1,1,1)
	end
	local txt = "Eq: " .. (LP.Team and LP.Team.Name or "-") .. " | Tgt: " .. (locked or (blocked and "Muro" or "Ninguno"))
	if txt ~= lastInfo then lastInfo = txt; info.Text = txt end
end)
